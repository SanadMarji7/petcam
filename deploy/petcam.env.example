# Petcam secrets and settings. Copy to petcam.env (or let ./configure.sh write
# it) and never commit petcam.env. Every value here can also be set as a plain
# environment variable; the names are the ones config.py reads.

# Public name of the pages. QR pairing links are https://<hostname>/cam#key=...
PETCAM_HOSTNAME=app.<domain>

# Pairing keys, at least 32 characters each, different from each other.
# Generate one with:  openssl rand -hex 32
PETCAM_PUBLISHER_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_PUBLISHER_KEY
PETCAM_VIEWER_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_VIEWER_KEY

# Where browsers connect for media. Caddy proxies this to LiveKit.
PETCAM_LIVEKIT_URL=wss://lk.<domain>

# LiveKit API credentials: any key name, secret at least 32 characters.
PETCAM_LIVEKIT_API_KEY=APIchangeme
PETCAM_LIVEKIT_API_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_LIVEKIT_SECRET

# The same pair in the "key: secret" form the LiveKit server reads
# (docker-compose.yml passes this file to the livekit service too).
LIVEKIT_KEYS=APIchangeme: CHANGE_ME_TO_A_RANDOM_32_CHAR_LIVEKIT_SECRET

# How many phones/laptops may watch at the same time.
PETCAM_MAX_VIEWERS=4

# LiveKit room name (one camera in phase 1).
PETCAM_ROOM_NAME=petcam

# Port uvicorn listens on inside the container; docker-compose.yml publishes
# it on 127.0.0.1:8000 only.
PETCAM_PORT=8000
