[Unit]
Description=Petcam WebRTC dog monitor (signaling server)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
# Change these three lines to your username and checkout path.
User=pi
Group=pi
WorkingDirectory=/home/pi/petcam
Environment="PATH=/home/pi/petcam/venv/bin:/usr/local/bin:/usr/bin:/bin"
# One worker only: the viewer/publisher state lives in this process.
ExecStart=/home/pi/petcam/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --log-level info
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

# Sandboxing: the server only needs to read its own directory.
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
